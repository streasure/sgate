{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "sgate 高性能游戏网关监控看板：QPS、延迟、错误率、CPU/内存水位、节点健康",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": "Prometheus",
      "title": "QPS（接收 / 转发 / 推送）",
      "type": "graph",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(sgate_messages_received_total[1m])", "legendFormat": "received" },
        { "expr": "rate(sgate_messages_forwarded_total[1m])", "legendFormat": "forwarded" },
        { "expr": "rate(sgate_messages_pushed_total[1m])", "legendFormat": "pushed" }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "丢弃消息速率（按原因）",
      "type": "graph",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        { "expr": "rate(sgate_messages_dropped_overload_total[1m])", "legendFormat": "overload" },
        { "expr": "rate(sgate_messages_dropped_full_total[1m])", "legendFormat": "full" },
        { "expr": "rate(sgate_messages_dropped_no_logic_total[1m])", "legendFormat": "no_logic" },
        { "expr": "rate(sgate_messages_dropped_no_conn_total[1m])", "legendFormat": "no_conn" }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "错误率",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(sgate_messages_dropped_overload_total[5m])) / (sum(rate(sgate_messages_received_total[5m])) + 1)",
          "legendFormat": "error_rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "datasource": "Prometheus",
      "title": "延迟分位数（P50/P95/P99/Max，μs）",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sgate_latency_p50_us", "legendFormat": "P50" },
        { "expr": "sgate_latency_p95_us", "legendFormat": "P95" },
        { "expr": "sgate_latency_p99_us", "legendFormat": "P99" },
        { "expr": "sgate_latency_max_us", "legendFormat": "Max" }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "CPU / 内存水位（%）",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sgate_cpu_percent", "legendFormat": "CPU" },
        { "expr": "sgate_mem_percent", "legendFormat": "Mem" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "datasource": "Prometheus",
      "title": "WAF 拦截数",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "targets": [{ "expr": "sgate_waf_blocked_total", "legendFormat": "blocked" }]
    },
    {
      "datasource": "Prometheus",
      "title": "活跃连接数",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
      "targets": [{ "expr": "sgate_active_connections", "legendFormat": "conns" }]
    },
    {
      "datasource": "Prometheus",
      "title": "集群 Leader 状态",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "targets": [{ "expr": "sgate_is_leader", "legendFormat": "leader" }]
    },
    {
      "datasource": "Prometheus",
      "title": "熔断触发数",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "targets": [{ "expr": "sgate_circuit_breaker_tripped_total", "legendFormat": "tripped" }]
    },
    {
      "datasource": "Prometheus",
      "title": "降级触发数",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 20 },
      "targets": [{ "expr": "sgate_degradation_triggered_total", "legendFormat": "degraded" }]
    },
    {
      "datasource": "Prometheus",
      "title": "灰度命中速率",
      "type": "graph",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 20 },
      "targets": [{ "expr": "rate(sgate_canary_hit_total[1m])", "legendFormat": "canary" }]
    },
    {
      "datasource": "Prometheus",
      "title": "镜像转发速率",
      "type": "graph",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 20 },
      "targets": [
        { "expr": "rate(sgate_traffic_mirror_forwarded_total[1m])", "legendFormat": "forwarded" },
        { "expr": "rate(sgate_traffic_mirror_dropped_total[1m])", "legendFormat": "dropped" }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "告警发送速率",
      "type": "graph",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 20 },
      "targets": [
        { "expr": "rate(sgate_alert_sent_total[1m])", "legendFormat": "sent" },
        { "expr": "rate(sgate_alert_dropped_total[1m])", "legendFormat": "dropped" }
      ]
    }
  ],
  "schemaVersion": 27,
  "style": "dark",
  "tags": ["sgate", "gateway", "game"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "timezone": "browser",
  "title": "sgate Gateway Overview",
  "uid": "sgate-overview",
  "version": 1
}
